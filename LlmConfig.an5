model LlmConfig {
  id        NVARCHAR(1000)  @id @default(uuid()) @description("Primary key")
  provider  NVARCHAR(100)   @description("LLM provider: openai, gemini, custom, azure")
  apiKey    NVARCHAR(4000)  @description("API key for the LLM provider")
  model     NVARCHAR(500)?  @description("Model name, e.g. gpt-4o, gemini-2.5-flash")
  endpoint  NVARCHAR(2000)? @description("Custom endpoint URL")
  isActive  BIT             @default(1) @description("Whether this config is active")
  createdAt DATETIME2       @default(now()) @description("Creation timestamp")
  updatedAt DATETIME2       @default(now()) @description("Last update timestamp")
  @@description("LLM provider configuration. Stores API keys and model settings for AI features.")
}
